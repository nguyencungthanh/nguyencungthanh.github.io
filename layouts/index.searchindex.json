{{- $list := slice -}}
{{- $pages := .Site.RegularPages -}}
{{- $pages = where $pages "Params.noindex" "ne" true -}}
{{- $pages = where $pages "Params.headless" "ne" true -}}
{{- $pages = where $pages "Section" "ne" "watches" -}}
{{- range $pages -}}
  {{- $date := "" -}}
  {{- if not .Date.IsZero -}}{{- $date = .Date.Format "2 January 2006" -}}{{- end -}}
  {{- $item := dict 
    "title" .Title 
    "permalink" .RelPermalink 
    "summary" (.Summary | plainify | htmlUnescape)
    "content" (.Plain | htmlUnescape)
    "date" $date
    "tags" .Params.tags 
  -}}
  {{- $list = $list | append $item -}}
{{- end -}}
{{- $list | jsonify -}}
